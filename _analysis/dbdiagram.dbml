Table users {
  id int [pk, increment, note: 'PK']
  name nvarchar(50) [not null, note: '사용자 이름']
  email nvarchar(100) [not null, unique, note: '로그인 이메일']
  password_hash nvarchar(255) [not null, note: '비밀번호 해시']
  signup_source varchar(20) [not null, default: 'email', note: '가입 경로']
  terms_agreed bit [not null, default: 0, note: '약관 동의 여부']
  is_active bit [not null, default: 1, note: '계정 활성 상태']
  last_login_at datetime [note: '마지막 로그인 시각']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table user_sessions {
  id int [pk, increment, note: 'PK']
  user_id int [not null, note: 'FK → users']
  session_token varchar(255) [not null, note: '세션 토큰']
  remember_me bit [not null, default: 0, note: '로그인 상태 유지 여부']
  login_ip varchar(45) [note: '로그인 IP']
  user_agent nvarchar(255) [note: '브라우저 정보']
  expires_at datetime [not null, note: '세션 만료 일시']
  last_seen_at datetime [note: '마지막 활동 일시']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table inquiries {
  id int [pk, increment, note: 'PK']
  user_id int [note: 'FK → users, 비회원 문의 가능']
  name nvarchar(50) [not null, note: '문의자 이름']
  email nvarchar(100) [not null, note: '문의자 이메일']
  inquiry_type nvarchar(30) [not null, default: '일반 문의', note: '문의 유형']
  subject nvarchar(200) [not null, note: '문의 제목']
  message nvarchar(max) [not null, note: '문의 내용']
  attachment_path nvarchar(255) [note: '첨부 파일 경로']
  status varchar(20) [not null, default: 'received', note: '문의 처리 상태']
  answered_at datetime [note: '답변 완료 일시']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table sponsorship_plans {
  id int [pk, increment, note: 'PK']
  name nvarchar(100) [not null, note: '플랜명']
  slug varchar(50) [not null, unique, note: '고유 슬러그']
  monthly_amount int [not null, default: 0, note: '월 후원 금액']
  badge_name nvarchar(50) [note: '배지명']
  benefit_summary nvarchar(max) [note: '혜택 요약']
  is_featured bit [not null, default: 0, note: '대표 노출 여부']
  is_active bit [not null, default: 1, note: '사용 여부']
  support_contact_email nvarchar(100) [note: '후원 문의 메일']
  sort_order int [not null, default: 0, note: '노출 순서']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table projects {
  id int [pk, increment, note: 'PK']
  user_id int [note: 'FK → users']
  title nvarchar(200) [not null, note: '프로젝트 제목']
  summary nvarchar(255) [not null, note: '한 줄 요약']
  description nvarchar(max) [not null, note: '프로젝트 상세 설명']
  category nvarchar(50) [not null, note: '카테고리']
  author_name nvarchar(50) [not null, note: '작성자 표시명']
  project_type varchar(20) [not null, default: 'personal', note: '프로젝트 유형']
  status varchar(20) [not null, default: 'draft', note: '프로젝트 상태']
  contest_name nvarchar(100) [note: '연결 콘테스트명']
  award_name nvarchar(100) [note: '수상명']
  github_url nvarchar(255) [note: 'GitHub 링크']
  demo_url nvarchar(255) [note: '데모 영상 링크']
  reference_url nvarchar(255) [note: '참고 링크']
  cover_image_path nvarchar(255) [note: '대표 이미지 경로']
  like_count int [not null, default: 0, note: '좋아요 수']
  view_count int [not null, default: 0, note: '조회 수']
  comment_count int [not null, default: 0, note: '댓글 수']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table project_tags {
  id int [pk, increment, note: 'PK']
  project_id int [not null, note: 'FK → projects']
  tag_name nvarchar(50) [not null, note: '태그명']
  sort_order int [not null, default: 0, note: '노출 순서']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Table project_comments {
  id int [pk, increment, note: 'PK']
  project_id int [not null, note: 'FK → projects']
  user_id int [note: 'FK → users']
  parent_comment_id int [note: '자기참조 FK, 답글용']
  author_name nvarchar(50) [not null, note: '작성자 표시명']
  content nvarchar(max) [not null, note: '댓글 내용']
  like_count int [not null, default: 0, note: '댓글 좋아요 수']
  created_at datetime [not null, default: `GETDATE()`, note: '등록일']
  updated_at datetime [not null, default: `GETDATE()`, note: '수정일']
}

Ref: user_sessions.user_id > users.id
Ref: inquiries.user_id > users.id
Ref: projects.user_id > users.id
Ref: project_tags.project_id > projects.id
Ref: project_comments.project_id > projects.id
Ref: project_comments.user_id > users.id
Ref: project_comments.parent_comment_id > project_comments.id